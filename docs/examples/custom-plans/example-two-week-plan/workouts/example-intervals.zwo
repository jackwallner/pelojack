<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <name>Example intervals</name>
  <description>Original ZWO format example, not a coached workout or training prescription.</description>
  <sportType>bike</sportType>
  <workout>
    <SteadyState Duration="120" Power="0.4"/>
    <IntervalsT Repeat="2" OnDuration="60" OffDuration="30" OnPower="0.7" OffPower="0.4"/>
    <SteadyState Duration="180" Power="0.55"/>
    <Cooldown Duration="120" PowerLow="0.5" PowerHigh="0.35"/>
  </workout>
</workout_file>
